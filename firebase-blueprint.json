{
  "entities": {
    "consumers": {
      "fields": {
        "id": { "type": "string", "description": "Unique record identifier" },
        "consumerId": { "type": "string", "description": "Electricity Account / Consumer Number" },
        "meterNo": { "type": "string", "description": "Meter serial number" },
        "name": { "type": "string", "description": "Full customer name" },
        "phone": { "type": "string", "description": "Primary mobile number for SMS and Voice Calling" },
        "email": { "type": "string", "description": "Customer email address" },
        "amount": { "type": "number", "description": "Unpaid bill balance in currency" },
        "dueDate": { "type": "string", "description": "Bill due date" },
        "overdueDays": { "type": "number", "description": "Calculated number of overdue days" },
        "tariffType": { "type": "string", "description": "Domestic, Commercial, Industrial, Agricultural" },
        "address": { "type": "string", "description": "Service billing address or substation feeder" },
        "status": { "type": "string", "description": "unpaid | partially_paid | paid | disputed | disconnected" },
        "lastSmsDate": { "type": "string", "description": "Timestamp of last SMS reminder" },
        "lastCallDate": { "type": "string", "description": "Timestamp of last AI Voice Call reminder" },
        "notes": { "type": "string", "description": "Internal collection agent notes" },
        "createdBy": { "type": "string", "description": "User ID who imported or owns the record" },
        "createdAt": { "type": "string", "description": "ISO timestamp created" },
        "updatedAt": { "type": "string", "description": "ISO timestamp last updated" }
      }
    },
    "dispatch_logs": {
      "fields": {
        "id": { "type": "string", "description": "Log record ID" },
        "type": { "type": "string", "description": "sms | aicall" },
        "consumerId": { "type": "string", "description": "Associated consumer ID" },
        "consumerName": { "type": "string", "description": "Consumer name" },
        "phone": { "type": "string", "description": "Destination phone number" },
        "amount": { "type": "number", "description": "Bill amount reminded" },
        "status": { "type": "string", "description": "delivered | sent | failed | completed | no-answer | busy" },
        "messageContent": { "type": "string", "description": "Dispatched SMS text or Voice script content" },
        "callDuration": { "type": "number", "description": "Call duration in seconds if voice call" },
        "callTranscript": { "type": "string", "description": "Simulated or actual AI call conversation transcript" },
        "customerResponse": { "type": "string", "description": "Keypad response or verbal commitment: promised_to_pay, requested_extension, dispute, etc." },
        "timestamp": { "type": "string", "description": "Dispatch timestamp" },
        "batchId": { "type": "string", "description": "Batch operation identifier" },
        "createdBy": { "type": "string", "description": "User ID who triggered the dispatch" }
      }
    },
    "reminder_templates": {
      "fields": {
        "id": { "type": "string", "description": "Template ID" },
        "type": { "type": "string", "description": "sms | aicall" },
        "title": { "type": "string", "description": "Template name e.g. Urgent Disconnection Notice" },
        "textTemplate": { "type": "string", "description": "Script with dynamic tags {name}, {amount}, {consumer_id}, {due_date}, {pay_link}" },
        "tone": { "type": "string", "description": "polite | firm | urgent | legal" },
        "language": { "type": "string", "description": "en | es | hi | te | ta | fr" },
        "voice": { "type": "string", "description": "Puck | Aoede | Fenrir | Kore | Charon | Natural" },
        "isDefault": { "type": "boolean", "description": "Whether this is active default template" },
        "createdBy": { "type": "string", "description": "User ID" }
      }
    },
    "settings": {
      "fields": {
        "utilityName": { "type": "string", "description": "Electric power board or utility company name" },
        "supportPhone": { "type": "string", "description": "Helpline phone number" },
        "paymentPortalUrl": { "type": "string", "description": "Online payment web URL" },
        "emailReportsTo": { "type": "string", "description": "Default email address for dispatch analytics reports" },
        "autoSyncGoogle": { "type": "boolean", "description": "Sync with Google Sheets automatically" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    }
  }
}
