{
  "entities": {
    "Consumer": {
      "title": "Consumer",
      "description": "A consumer who owes an electricity bill.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "consumerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 20 },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 32 },
        "overdueDays": { "type": "number" },
        "tariffType": { "type": "string", "enum": ["Domestic", "Commercial", "Industrial", "Agricultural"] },
        "address": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["unpaid", "paid"] },
        "hasNoWhatsApp": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["consumerId", "name", "phone", "amount", "dueDate", "status"]
    },
    "DispatchLog": {
      "title": "DispatchLog",
      "description": "Log of a dispatched SMS, Voice, or WhatsApp message.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "consumerId": { "type": "string", "maxLength": 128 },
        "consumerName": { "type": "string", "maxLength": 256 },
        "type": { "type": "string", "enum": ["sms", "voice", "whatsapp"] },
        "status": { "type": "string", "enum": ["delivered", "failed", "pending", "completed", "answered", "voicemail"] },
        "timestamp": { "type": "string" },
        "notes": { "type": "string", "maxLength": 2048 },
        "cost": { "type": "number" },
        "duration": { "type": "number" }
      },
      "required": ["consumerId", "consumerName", "type", "status", "timestamp"]
    }
  },
  "firestore": {
    "consumers": {
      "schema": "Consumer",
      "description": "Collection of consumers"
    },
    "logs": {
      "schema": "DispatchLog",
      "description": "Collection of dispatch logs"
    }
  }
}
